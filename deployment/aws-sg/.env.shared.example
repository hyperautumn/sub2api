# Official Sub2API v0.2.21 image index. Includes linux/amd64 and linux/arm64.
SUB2API_IMAGE=docker.io/weishaw/sub2api@sha256:868c15f3c729af05896c94b3456d91a68bc81dce50c4d7b4557682df7ca92c13
RUN_MODE=standard
SERVER_MODE=release
TZ=UTC

# RDS writer endpoint, DNS name only. Use the application role and a precreated DB.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_DBNAME=sub2api
DATABASE_PASSWORD=
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

# ElastiCache primary endpoint, DNS name only. Cluster mode disabled, TLS + AUTH.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=5

# Generate separately once with openssl rand -hex 32. Share both values across nodes.
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

# Replace with the actual public ALB subnet CIDRs if the VPC layout differs.
SERVER_TRUSTED_PROXIES=10.10.0.0/24,10.10.1.0/24

# Blank uses Sub2API's built-in allowlist. A custom list replaces the defaults.
SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
